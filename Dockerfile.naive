# Question 1, Part 1 -- NAIVE single-stage build.
# Everything (build toolchain, training deps, dataset, pip cache) ends up in the
# one and only layer stack that gets shipped.
FROM python:3.11

WORKDIR /app

# Whole build context in one shot -- no layer-cache discipline.
COPY . /app

# Runtime deps AND training-only deps, with pip's wheel cache left in place.
RUN pip install -r requirements.txt -r requirements-train.txt

# Train the model inside the image.
RUN python app/train.py --data spam_dataset.csv --out /app/model.joblib

ENV MODEL_PATH=/app/model.joblib
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
